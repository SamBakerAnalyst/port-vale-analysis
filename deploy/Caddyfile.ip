{
	auto_https off
}

# IP-only site: compress everything, serve static from disk, proxy the app.
:80 {
	encode zstd gzip

	# JS/CSS/images/fonts — long cache. Pages use ?v=… so deploys still bust.
	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=604800, immutable"
		file_server
	}

	@standalone_assets path_regexp ^/standalone/.*\.(js|css|png|jpe?g|webp|svg|json|woff2?|map)$
	handle @standalone_assets {
		root * /srv
		header Cache-Control "public, max-age=604800, immutable"
		file_server
	}

	handle {
		reverse_proxy hub:8000 {
			health_uri /health
			health_interval 10s
			health_timeout 5s
			fail_duration 15s
			max_fails 3
		}
	}
}

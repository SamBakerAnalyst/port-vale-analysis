{
	auto_https off
}

# IP-only site: compress everything, serve static from disk, proxy the app.
:80 {
	encode zstd gzip

	# Cache assets but always revalidate — Caddy auto-generates ETags from
	# file content, so after a deploy the browser fetches the new file
	# without needing manual ?v= bumps. Adds ~50ms (one HEAD) per asset.
	handle /static/* {
		root * /srv
		header Cache-Control "public, no-cache"
		file_server
	}

	@standalone_assets path_regexp ^/standalone/.*\.(js|css|png|jpe?g|webp|svg|json|woff2?|map)$
	handle @standalone_assets {
		root * /srv
		header Cache-Control "public, no-cache"
		file_server
	}

	# Single upstream — no active health checker (was marking hub dead under load → 503).
	handle {
		reverse_proxy hub:8000
	}
}

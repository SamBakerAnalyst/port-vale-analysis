IMPECT_USERNAME=your_email@example.com
IMPECT_PASSWORD=your_password
IMPECT_CLIENT_ID=api
IMPECT_TOKEN_URL=https://login.impect.com/auth/realms/production/protocol/openid-connect/token
IMPECT_BASE_URL=https://api.impect.com
# Profile and player score endpoints use the same customer API prefix.
IMPECT_API_PREFIX=customerapi

# Fixture assignment emails (Microsoft 365 / Outlook)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sam.baker@port-vale.co.uk
SMTP_PASSWORD=your_mailbox_or_app_password
FIXTURE_EMAIL_FROM=sam.baker@port-vale.co.uk
FIXTURE_EMAIL_FROM_NAME=Sam Baker · Port Vale Recruitment
# Comma-separated admin addresses for LIVE ticket requests
FIXTURE_ADMIN_EMAILS=jess.frost@port-vale.co.uk,jack.mountford@port-vale.co.uk
# Optional override for fortnight schedule (defaults to recruitment staff emails)
# FIXTURE_SCHEDULE_EMAILS=Lee.darnbrough@port-vale.co.uk,Tommy.johnson@port-vale.co.uk
# Public base URL used in assignment "reject game" links (live hub — never localhost)
FIXTURE_APP_BASE_URL=http://178.128.161.215
# Who gets emailed when a scout rejects (defaults to FIXTURE_EMAIL_FROM)
# FIXTURE_REJECT_NOTIFY_EMAIL=sam.baker@port-vale.co.uk
# Optional signing secret for reject links (defaults to SMTP_PASSWORD)
# FIXTURE_REJECT_SECRET=change-me

# Hub staff login (admin — full access)
TEAM_USERNAME=PortVale
TEAM_PASSWORD=change-me
HUB_AUTH_SECRET=change-me-to-a-long-random-string

# Analysis-only account (Pre-Match, xG Chance, Post-Match only)
ANALYSIS_USERNAME=Port Vale Analysis
ANALYSIS_PASSWORD=PortVale123!
